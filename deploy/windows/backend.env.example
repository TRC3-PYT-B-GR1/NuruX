# Copy this file to backend/.env on the Windows server and replace every placeholder.
DEBUG=False
SECRET_KEY=replace-with-a-long-random-secret
ALLOWED_HOSTS=nurux.example.com

# Supabase Dashboard > Connect > Session pooler (port 5432).
# URL-encode special characters in the database password.
DATABASE_URL=postgresql://postgres.PROJECT_REF:ENCODED_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres
DB_CONN_MAX_AGE=600

# With the recommended same-origin IIS setup, browser requests use /api.
CORS_ALLOWED_ORIGINS=https://nurux.example.com
CSRF_TRUSTED_ORIGINS=https://nurux.example.com
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000

ACCESS_TOKEN_LIFETIME_MINUTES=15
REFRESH_TOKEN_LIFETIME_DAYS=7
MAX_FAILED_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=15

WORKDAY_START=09:00
WORKDAY_END=17:00
ATTENDANCE_GRACE_MINUTES=15

GEMINI_API_KEY=
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

PAYROLL_TAX_RATE=0.05
PAYROLL_PENSION_RATE=0.08
PAYROLL_NHF_RATE=0.025

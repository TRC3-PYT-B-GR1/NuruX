# Canonical Django API (run commands from backend/)
DEBUG=True
SECRET_KEY=change-this-to-a-long-random-string
ALLOWED_HOSTS=localhost,127.0.0.1

# Omit DATABASE_URL locally to use backend/db.sqlite3.
# On an IPv4 Windows server, use Supabase's Session Pooler connection on port 5432.
# URL-encode special characters in the password.
# DATABASE_URL=postgresql://postgres.PROJECT_REF:ENCODED_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres
DB_CONN_MAX_AGE=600

# JWT
ACCESS_TOKEN_LIFETIME_MINUTES=15
REFRESH_TOKEN_LIFETIME_DAYS=7

# Account lockout policy
MAX_FAILED_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=15

# CORS (frontend origin, comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:5173
CSRF_TRUSTED_ORIGINS=
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=3600

# Attendance policy
WORKDAY_START=09:00
WORKDAY_END=17:00
ATTENDANCE_GRACE_MINUTES=15

# Optional services
GEMINI_API_KEY=
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# Payroll estimate rates; verify for your jurisdiction before use.
PAYROLL_TAX_RATE=0.05
PAYROLL_PENSION_RATE=0.08
PAYROLL_NHF_RATE=0.025
